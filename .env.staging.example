# Copy to .env.staging and replace every placeholder before use.
# Generate each secret independently; do not reuse production credentials.
NODE_ENV=production
PORT=4100

# Use the dedicated least-privilege account created by
# database/create_staging_database.sql. Keep the password URL-safe.
DATABASE_URL=mysql://digiink_staging:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@127.0.0.1:3306/digiink_crm_staging

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SEED_SUPER_ADMIN_EMAIL=staging-admin@example.invalid
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STAGING_ADMIN_PASSWORD

REDIS_URL=redis://127.0.0.1:6379/1
APP_URL=http://localhost:5174
API_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:5174
UPLOADS_DIR=../uploads-staging

# Configure a dedicated staging mail account before testing email workflows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Digiink Staging <staging@example.invalid>
