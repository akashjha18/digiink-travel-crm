// =============================================================================
// Digiink Solutions Travel CRM — UNIFIED SCHEMA (single shared MySQL database)
//
// ARCHITECTURE NOTE: the SRS's original design called for one isolated MySQL
// database per client. This project intentionally uses a single shared
// database instead, with every tenant-scoped model carrying a `clientId`
// column, because local development runs on XAMPP/MariaDB where spinning up
// and migrating a fresh database per client isn't practical. Isolation is
// now enforced in application code (every tenant query is scoped by
// clientId — see tenant-scope.guard.ts) rather than structurally by the
// database layer. If this ever moves to a real per-client-DB deployment,
// this is the file that would need to split back into control + tenant
// schemas.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Control-level models (Super Admin only)
// -----------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  GRACE
  LOCKED
  DELETED
}

model Plan {
  id                   String   @id @default(cuid())
  name                 String   @unique
  priceInPaise         Int
  entitlements         Json
  maxUsers             Int?
  maxEnquiriesPerMonth Int?
  maxBranches          Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clients Client[]

  @@map("plans")
}

model Client {
  id           String @id @default(cuid())
  clientCode   String @unique
  businessName String
  ownerName    String
  email        String @unique
  phone        String

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionStart  DateTime
  subscriptionExpiry DateTime
  graceEndsAt        DateTime?
  lockedAt           DateTime?
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingCompleted Boolean @default(false)

  paymentLogs    PaymentLog[]
  paymentNotices PaymentNotice[]
  roles          Role[]
  users          User[]
  customers      Customer[]
  enquiries      Enquiry[]
  followUps      FollowUp[]
  quotations     Quotation[]
  bookings       Booking[]
  trips          Trip[]
  drivers        Driver[]
  vehicles       Vehicle[]
  payments       Payment[]
  invoices       Invoice[]
  documents      Document[]
  auditLogs      AuditLog[]
  companyProfile CompanyProfile?
  branches       Branch[]
  automationRules AutomationRule[]
  automationLogs  AutomationLog[]
  whatsAppConfig      WhatsAppConfig?
  whatsAppMessages    WhatsAppMessage[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]

  @@index([subscriptionStatus])
  @@map("clients")
}

// Step 1+2 of the onboarding wizard (SRS section 13). One row per client.
model CompanyProfile {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id])
  companyName  String?
  logoUrl      String?
  address      String?
  gstNumber    String?
  phone        String?
  email        String?
  businessType String?
  currency     String?  @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("company_profiles")
}

// Step 3 of onboarding — only shown/usable when the client's plan includes
// multi_branch (Enterprise). Kept minimal here; full multi-branch data
// scoping is a Phase 10 (Enterprise) concern.
model Branch {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  customers Customer[]
  enquiries Enquiry[]
  bookings  Booking[]

  @@index([clientId])
  @@map("branches")
}

// Short-lived email OTP issued after password verification on login.
// Never stores the plain code — only a hash — and is single-use.
model LoginOtp {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("login_otps")
}

model PaymentLog {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  amountInPaise Int
  date          DateTime
  mode          String
  reference     String?
  note          String?
  confirmedBy   String
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@map("payment_logs")
}

model PaymentNotice {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  message    String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([clientId])
  @@map("payment_notices")
}

model SuperAdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("super_admin_users")
}

model SuperAdminAuditLog {
  id             String   @id @default(cuid())
  actorId        String
  actorEmail     String
  action         String
  targetClientId String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([targetClientId])
  @@map("super_admin_audit_logs")
}

model SystemSetting {
  key   String @id
  value Json

  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// Tenant-scoped models — every one of these carries clientId. Every query
// against them MUST filter by clientId (see tenant-scope.guard.ts /
// common/scoped-prisma.ts) since the database itself no longer enforces
// isolation structurally.
// -----------------------------------------------------------------------------

model Role {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  name            String
  permissionsJson Json
  isSystemRole    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users User[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("roles")
}

model User {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id])
  name               String
  email              String    @unique
  passwordHash       String
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  isClientAdmin      Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enquiriesAssigned Enquiry[]  @relation("AssignedStaff")
  followUps         FollowUp[]
  auditLogs         AuditLog[]

  @@index([clientId])
  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries  Enquiry[]
  quotations Quotation[]
  bookings   Booking[]
  payments   Payment[]
  invoices   Invoice[]
  documents  Document[]

  @@index([clientId])
  @@map("customers")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

model Enquiry {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  source       String?
  destination  String?
  travelDate   DateTime?
  status       EnquiryStatus @default(NEW)
  assignedToId String?
  assignedTo   User?         @relation("AssignedStaff", fields: [assignedToId], references: [id])
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  followUps  FollowUp[]
  quotations Quotation[]

  @@index([clientId])
  @@index([clientId, status])
  @@map("enquiries")
}

model FollowUp {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  enquiryId    String
  enquiry      Enquiry  @relation(fields: [enquiryId], references: [id])
  loggedById   String
  loggedBy     User     @relation(fields: [loggedById], references: [id])
  activityType String
  description  String?
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([enquiryId])
  @@map("follow_ups")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id                 String          @id @default(cuid())
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id])
  enquiryId          String
  enquiry            Enquiry         @relation(fields: [enquiryId], references: [id])
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  version            Int             @default(1)
  itineraryJson      Json
  markupInPaise      Int             @default(0)
  discountInPaise    Int             @default(0)
  taxInPaise         Int             @default(0)
  totalInPaise       Int
  termsAndConditions String?         @db.Text
  pdfFileUrl         String?
  status             QuotationStatus @default(DRAFT)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  booking Booking?

  @@index([clientId])
  @@map("quotations")
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  quotationId   String        @unique
  quotation     Quotation     @relation(fields: [quotationId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  travelStart   DateTime?
  travelEnd     DateTime?
  amountInPaise Int
  status        BookingStatus @default(CONFIRMED)
  voucherPdfUrl String?
  paymentDueDate DateTime?
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id])
  driverId      String?
  driver        Driver?       @relation(fields: [driverId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trip     Trip?
  payments Payment[]
  invoices Invoice[]

  @@index([clientId])
  @@map("bookings")
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id             String     @id @default(cuid())
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id])
  bookingId      String     @unique
  booking        Booking    @relation(fields: [bookingId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  pickup         String?
  drop           String?
  itineraryNotes String?    @db.Text
  driverId       String?
  driver         Driver?    @relation(fields: [driverId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id])
  status         TripStatus @default(SCHEDULED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([clientId])
  @@map("trips")
}

model Driver {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  name          String
  licenseNumber String
  contact       String
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles  Vehicle[]
  bookings  Booking[]
  trips     Trip[]
  documents Document[]

  @@index([clientId])
  @@map("drivers")
}

model Vehicle {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id])
  vehicleType        String
  registrationNumber String
  capacity           Int
  isAvailable        Boolean   @default(true)
  rcExpiry           DateTime?
  insuranceExpiry    DateTime?
  permitExpiry       DateTime?
  assignedDriverId   String?
  assignedDriver     Driver?   @relation(fields: [assignedDriverId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings  Booking[]
  trips     Trip[]
  documents Document[]

  @@unique([clientId, registrationNumber])
  @@index([clientId])
  @@map("vehicles")
}

model Payment {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amountInPaise Int
  mode          String
  paymentDate   DateTime
  reference     String?
  recordedById  String
  notes         String?
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@map("payments")
}

model Invoice {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  hsnSac          String?
  subtotalInPaise Int
  gstInPaise      Int
  totalInPaise    Int
  pdfFileUrl      String?
  createdAt       DateTime @default(now())

  @@index([clientId])
  @@map("invoices")
}

model Document {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  type       String
  fileUrl    String
  fileKey    String
  fileSize   Int?
  expiryDate DateTime?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  @@index([clientId])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("audit_log")
}

// No-code Workflow Automation (SRS section 11/FR-11, Business+ only via
// the workflow_automation entitlement). A rule is trigger -> action; the
// condition lives inside the trigger's config (e.g. "hours: 2"). The
// automation-engine BullMQ job (jobs/automation-engine.job.ts) evaluates
// active rules on a schedule — there is no real-time event bus, so
// triggers fire on the next sweep after the condition becomes true, not
// instantly.
model AutomationRule {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  name          String
  isActive      Boolean  @default(true)
  triggerType   String   // ENQUIRY_NO_CONTACT_WITHIN_HOURS | QUOTATION_NOT_FOLLOWED_UP | BOOKING_PAYMENT_OVERDUE | VEHICLE_DOCUMENT_EXPIRING
  triggerConfig Json
  actionType    String   // EMAIL_STAFF | CREATE_FOLLOWUP_NOTE | REASSIGN_ENQUIRY
  actionConfig  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs AutomationLog[]

  @@index([clientId])
  @@map("automation_rules")
}

// One row per rule firing against one target — doubles as both the audit
// trail and the de-duplication check (the engine won't refire the same
// rule against the same target within its cooldown window).
model AutomationLog {
  id         String         @id @default(cuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id])
  targetType String         // ENQUIRY | QUOTATION | BOOKING | VEHICLE
  targetId   String
  message    String?
  createdAt  DateTime       @default(now())

  @@index([clientId])
  @@index([ruleId, targetId])
  @@map("automation_logs")
}

// -----------------------------------------------------------------------------
// Enterprise-only models (Phase 10) — Multi-Branch already reuses the
// Branch model added in onboarding; these two are new: WhatsApp Business
// API integration and the Custom Module (custom fields) framework.
// -----------------------------------------------------------------------------

// One row per client. accessTokenEncrypted is only ever populated once a
// real Meta Business API app is connected — see whatsapp.controller.ts for
// why this is scaffolding rather than a working integration out of the box.
model WhatsAppConfig {
  id                     String   @id @default(cuid())
  clientId               String   @unique
  client                 Client   @relation(fields: [clientId], references: [id])
  phoneNumberId          String?
  businessAccountId      String?
  accessTokenEncrypted   String?
  webhookVerifyToken     String?
  isActive               Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("whatsapp_configs")
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  enquiryId   String?
  direction   String   // INBOUND | OUTBOUND
  fromNumber  String
  toNumber    String
  body        String   @db.Text
  status      String   @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([enquiryId])
  @@map("whatsapp_messages")
}

// No-code Custom Module framework (SRS section 12/FR-12.3, Enterprise
// only). Deliberately scoped to "add custom fields to an existing module"
// rather than building an arbitrary new-module generator — that covers
// the realistic 80% case (an agency wants to track "Passport Number" or
// "Visa Status" on Customers) without an open-ended schema-builder.
model CustomFieldDefinition {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  module    String   // e.g. "customers", "enquiries", "bookings"
  fieldKey  String   // machine key, e.g. "passport_number"
  label     String   // display label, e.g. "Passport Number"
  fieldType String   // TEXT | NUMBER | DATE | BOOLEAN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  values CustomFieldValue[]

  @@unique([clientId, module, fieldKey])
  @@index([clientId])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  clientId     String
  client       Client                @relation(fields: [clientId], references: [id])
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id])
  recordId     String                // the id of the Customer/Enquiry/etc row this value belongs to
  value        Json
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, recordId])
  @@index([clientId])
  @@map("custom_field_values")
}
