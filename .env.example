NODE_ENV=development

# Single shared database (XAMPP/MariaDB-friendly). Tenant rows are isolated
# by clientId in application code — see backend/prisma/schema.prisma.
DATABASE_URL="mysql://root:@localhost:3306/digiink_crm"

JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL="redis://localhost:6379"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Digiink Solutions <no-reply@digiinksolutions.com>"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=digiink-crm-files

APP_URL=http://localhost:5173
API_URL=http://localhost:4000

PORT=4000

SUBSCRIPTION_EXPIRING_SOON_DAYS=7
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_DELETE_AFTER_DAYS=20
